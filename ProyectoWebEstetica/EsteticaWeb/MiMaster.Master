<head runat="server">
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>EsteticaWeb</title>
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous" />
    <link href="~/site.css" rel="stylesheet" type="text/css" />
    <link href="~/estetimed.css" rel="stylesheet" type="text/css" runat="server" />
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
</head>
<body>
    <form id="form1" runat="server">
           <nav class="navbar navbar-expand-lg navbar-dark py-2"
     style="background: linear-gradient(90deg, #28133f, #5b2c83);"
     data-bs-theme="dark">
                <div class="container-fluid">
                    <a class="navbar-brand fw-bold" href="Inicio.aspx">
    <span style="color: #c58be9; font-size: 26px;">🪷</span>
    EstetiMed
    <small class="ms-2 fw-normal" style="font-size: 13px; color: #d8c9e9;">
        | Medicina Estética
    </small>
</a>
                    <div class="d-flex ms-auto align-items-center">

    <asp:HyperLink
        ID="lnkIngresar"
        runat="server"
        NavigateUrl="~/Login.aspx"
        CssClass="btn btn-outline-light btn-sm fw-semibold px-3">
        Ingresar
    </asp:HyperLink>

    <asp:Label
        ID="lblUsuarioNavbar"
        runat="server"
        CssClass="text-white me-3"
        Visible="false">
    </asp:Label>

    <asp:LinkButton
        ID="btnCerrarSesion"
        runat="server"
        CssClass="btn btn-outline-light btn-sm fw-semibold px-3"
        CausesValidation="false"
        Visible="false"
        OnClick="btnCerrarSesion_Click">
        Cerrar sesión
    </asp:LinkButton>

</div>
                </div>
            </nav>
            <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
            </asp:ContentPlaceHolder>

    </form>
</body>
</html>
